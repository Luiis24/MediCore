<!DOCTYPE html>
<html lang="es" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MediCore | Sistema Médico</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        .sidebar { min-height: 100vh; border-right: 1px solid var(--bs-border-color); transition: background-color 0.3s; }
        .navbar-brand { font-weight: 700; color: #0d6efd !important; }
    </style>
</head>
<body>
    <!-- Barra superior para móviles con botón Hamburguesa -->
    <nav class="navbar navbar-expand-md d-md-none bg-body-tertiary border-bottom px-3">
        <a class="navbar-brand" href="/"><i class="bi bi-heart-pulse-fill me-2"></i>MediCore</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileSidebar" aria-controls="mobileSidebar">
            <span class="navbar-toggler-icon"></span>
        </button>
    </nav>

    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar para Desktop -->
            <nav id="sidebar" class="col-md-3 col-lg-2 d-none d-md-flex flex-column sidebar p-3 justify-content-between">
                <div>
                    <a href="/" class="navbar-brand d-flex align-items-center mb-3 mb-md-0 text-decoration-none">
                        <i class="bi bi-heart-pulse-fill fs-4 me-2"></i>
                        <span class="fs-5">MediCore</span>
                    </a>
                    <hr>
                    @{
                        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
                        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
                        bool isDashboard = currentController == "Home";
                        bool isPatients = currentController == "Patients";
                    }
                    <ul class="nav nav-pills flex-column mb-auto">
                        <li class="nav-item mb-1">
                            <a href="/" class="nav-link @(isDashboard ? "active" : "link-body-emphasis")">
                                <i class="bi bi-speedometer2 me-2"></i> Dashboard
                            </a>
                        </li>
                        <li class="nav-item mb-1">
                            <a href="/Patients/Index" class="nav-link @(isPatients ? "active" : "link-body-emphasis")">
                                <i class="bi bi-people-fill me-2"></i> Pacientes
                            </a>
                        </li>
                    </ul>
                </div>
                <!-- Botón Modo Oscuro en la parte inferior -->
                <div class="pt-3 border-top">
                    <button class="btn btn-outline-secondary w-d-100 w-100 d-flex align-items-center justify-content-center" id="darkModeToggle">
                        <i class="bi bi-moon-stars-fill me-2" id="themeIcon"></i> <span id="themeText">Modo Oscuro</span>
                    </button>
                </div>
            </nav>

            <!-- Sidebar Offcanvas para Móviles -->
            <div class="offcanvas offcanvas-start" tabindex="-1" id="mobileSidebar" aria-labelledby="mobileSidebarLabel">
                <div class="offcanvas-header">
                    <h5 class="offcanvas-title navbar-brand" id="mobileSidebarLabel"><i class="bi bi-heart-pulse-fill me-2"></i>MediCore</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                </div>
                <div class="offcanvas-body d-flex flex-column justify-content-between">
                    <ul class="nav nav-pills flex-column mb-auto">
                        <li class="nav-item mb-1">
                            <a href="/" class="nav-link @(isDashboard ? "active" : "link-body-emphasis")">
                                <i class="bi bi-speedometer2 me-2"></i> Dashboard
                            </a>
                        </li>
                        <li class="nav-item mb-1">
                            <a href="/Patients/Index" class="nav-link @(isPatients ? "active" : "link-body-emphasis")">
                                <i class="bi bi-people-fill me-2"></i> Pacientes
                            </a>
                        </li>
                    </ul>
                    <div class="pt-3 border-top">
                        <button class="btn btn-outline-secondary w-100 d-flex align-items-center justify-content-center mobileDarkModeToggle">
                            <i class="bi bi-moon-stars-fill me-2"></i> Cambiar Modo
                        </button>
                    </div>
                </div>
            </div>

            <!-- Contenido Principal -->
            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 py-4">
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script>
        // Lógica para alternar el Modo Oscuro / Claro
        const htmlElement = document.documentElement;
        const toggleBtn = document.getElementById('darkModeToggle');
        const themeIcon = document.getElementById('themeIcon');
        const themeText = document.getElementById('themeText');

        function setTheme(theme) {
            htmlElement.setAttribute('data-bs-theme', theme);
            localStorage.setItem('theme', theme);
            if (theme === 'dark') {
                themeIcon.className = 'bi bi-sun-fill me-2';
                themeText.textContent = 'Modo Claro';
            } else {
                themeIcon.className = 'bi bi-moon-stars-fill me-2';
                themeText.textContent = 'Modo Oscuro';
            }
        }

        // Recuperar preferencia guardada
        const savedTheme = localStorage.getItem('theme') || 'light';
        setTheme(savedTheme);

        toggleBtn.addEventListener('click', () => {
            const currentTheme = htmlElement.getAttribute('data-bs-theme');
            setTheme(currentTheme === 'light' ? 'dark' : 'light');
        });

        document.querySelectorAll('.mobileDarkModeToggle').forEach(btn => {
            btn.addEventListener('click', () => {
                const currentTheme = htmlElement.getAttribute('data-bs-theme');
                setTheme(currentTheme === 'light' ? 'dark' : 'light');
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>