@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2">Panel General / Dashboard</h1>
    <a asp-action="CreateAppointment" class="btn btn-primary"><i class="bi bi-calendar-plus-fill me-1"></i> Programar
        Cita</a>
    </div>

    <!-- Tarjetas de Métricas -->
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="card text-white bg-primary shadow-sm">
                <div class="card-body">
                    <h6 class="card-title text-uppercase">Total Pacientes</h6>
                    <h2 class="display-6 fw-bold">@ViewBag.TotalPatients</h2>
                    <i class="bi bi-people fs-1 position-absolute top-50 end-0 translate-middle-y me-3 opacity-50"></i>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-success shadow-sm">
                <div class="card-body">
                    <h6 class="card-title text-uppercase">Pacientes Activos</h6>
                    <h2 class="display-6 fw-bold">@ViewBag.ActivePatients</h2>
                    <i
                    class="bi bi-person-check fs-1 position-absolute top-50 end-0 translate-middle-y me-3 opacity-50"></i>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-info shadow-sm">
                <div class="card-body">
                    <h6 class="card-title text-uppercase">Citas Totales</h6>
                    <h2 class="display-6 fw-bold">@ViewBag.TotalAppointments</h2>
                    <i
                    class="bi bi-calendar-check fs-1 position-absolute top-50 end-0 translate-middle-y me-3 opacity-50"></i>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-warning shadow-sm">
                <div class="card-body">
                    <h6 class="card-title text-uppercase">Citas de Hoy</h6>
                    <h2 class="display-6 fw-bold">@ViewBag.TodayAppointments</h2>
                    <i
                    class="bi bi-clock-history fs-1 position-absolute top-50 end-0 translate-middle-y me-3 opacity-50"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabla de Citas Recientes con Acciones -->
    <div class="card shadow-sm">
        <div class="card-header py-3">
            <h5 class="mb-0 fw-bold"><i class="bi bi-list-check me-2"></i>Últimas Citas Registradas</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Paciente</th>
                            <th>Fecha y Hora</th>
                            <th>Motivo</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var app in Model)
                        {
                            <tr>
                                <td><strong>@app.Patient?.Name</strong></td>
                                <td>@app.AppointmentDate.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>@app.Reason</td>
                                <td>
                                    <span
                                        class="badge @(app.Status == "Completada" ? "bg-success" : (app.Status == "Programada" ? "bg-primary" : "bg-danger"))">
                                        @app.Status
                                    </span>
                                </td>
                                <td>
                                    @if (app.Status == "Programada")
                                    {
                                        <form asp-action="UpdateStatus" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@app.Id" />
                                            <input type="hidden" name="status" value="Completada" />
                                            <button type="submit" class="btn btn-sm btn-outline-success" title="Completar Cita"><i
                                                class="bi bi-check-lg"></i></button>
                                            </form>
                                            <form asp-action="UpdateStatus" method="post" class="d-inline">
                                                <input type="hidden" name="id" value="@app.Id" />
                                                <input type="hidden" name="status" value="Cancelada" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Cancelar Cita"><i
                                                    class="bi bi-x-lg"></i></button>
                                                </form>
                                            }
                                else
                                            {
                                                <span class="text-muted small">Sin acciones</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>